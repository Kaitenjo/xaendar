{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "node_modules/@xaendar/core/globals.d.ts"
  ]
}
