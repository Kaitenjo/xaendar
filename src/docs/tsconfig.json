{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@xaendar/common": ["../../packages/common/src/public-api"],
      "@xaendar/core": ["../../packages/core/src/public-api"],
      "@xaendar/core/signals": ["../../packages/core/src/signals/index.ts"],
      "@xaendar/signals": ["../../packages/signals/src/public-api"],
      "@xaendar/ssr": ["../../packages/ssr/src/public-api"],
      "@xaendar/ssr/dom": ["../../packages/ssr/src/dom/index"],
      "@xaendar/types": ["../../packages/types/src/public-api"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/core/src/globals.d.ts",
    "../../packages/core/src/window.d.ts",
    "./server.ts"
  ],
  "exclude": [
    "demos",
    "dist",
    "node_modules",
    "src/snippets/**"
  ]
}
