{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@xaendar/common": [
        "../../../../packages/common/src/public-api"
      ],
      "@xaendar/internals": [
        "../../../../packages/internals/src/public-api"
      ],
      "@xaendar/core": [
        "../../../../packages/core/src/public-api"
      ],
      "@xaendar/core/signals": [
        "../../../../packages/core/src/signals/index.ts"
      ],
      "@xaendar/directives": [
        "../../../../packages/directives/src/public-api"
      ],
      "@xaendar/signals": [
        "../../../../packages/signals/src/public-api"
      ],
      "@xaendar/types": [
        "../../../../packages/types/src/public-api"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts",
    "../../../../packages/core/src/globals.d.ts",
    "../../../../packages/core/src/window.d.ts"
  ]
}
