{
  "name": "xaendar",
  "version": "0.13.0",
  "author": "Kaitenjo",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build:claude-plugin": "npm run build:schematics && npm run build-claude-plugin --prefix schematics",
    "build:docs": "npm run build --prefix src/docs",
    "build:projects": "npm run build-projects --prefix schematics",
    "build:schematics": "npm run build --prefix schematics",
    "build:schematics:watch": "npm run build:watch --prefix schematics",
    "build:watch:extension": "npm run build:watch:extension --prefix schematics",
    "check:dependencies": "npm run check-dependencies --prefix schematics",
    "deploy": "npm run build:schematics && npm run check:dependencies && npm run test && npm run typecheck:projects && npm run update:version && npm run build:projects && npm run pack:projects && npm run publish:projects && npm i",
    "i": "npm i --ignore-scripts",
    "i:clean": "rimraf package-lock.json node_modules && npm run i",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pack:projects": "npm run pack --prefix schematics",
    "publish:projects": "npm run publish --prefix schematics",
    "start": "npm start --prefix src/docs",
    "pretest": "npm run typecheck:specs",
    "test": "vitest",
    "pretest:watch": "npm run typecheck:specs",
    "test:watch": "vitest --watch",
    "pretest:coverage": "npm run typecheck:specs",
    "test:coverage": "vitest --coverage",
    "typecheck:projects": "npm run typecheck-projects --prefix schematics",
    "typecheck:specs": "node schematics/src/typecheck-specs.ts",
    "update:version": "npm run update-version --prefix schematics"
  },
  "dependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "commander": "^15.0.0",
    "entities": "^8.1.0",
    "fast-glob": "^3.3.3",
    "lightningcss": "1.33.0",
    "magic-string": "^1.4.3",
    "typescript": "^6.0.3",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/convert-source-map": "^2.0.3",
    "@types/less": "^3.0.8",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vitest/coverage-v8": "^5.0.5",
    "depcheck": "^1.4.7",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "less": "^4.9.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "sass": "^1.105.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "5.1.0",
    "vitest": "^5.0.5",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "engines": {
    "node": ">=26.8.0",
    "npm": ">=12.0.0"
  }
}