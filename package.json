{
  "name": "xaendar",
  "version": "0.12.0",
  "author": "Kaitenjo",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build:projects": "npm run build-projects --prefix schematics",
    "build:schematics": "npm run build --prefix schematics",
    "build:schematics:watch": "npm run build:watch --prefix schematics",
    "build:src": "vite build",
    "build:watch:extension": "npm run build:watch:extension --prefix schematics",
    "check:dependencies": "npm run check-dependencies --prefix schematics",
    "deploy": "npm run build:schematics && npm run check:dependencies && npm run typecheck:projects && npm run update:version && npm run build:projects && npm run pack:projects && npm run publish:projects && npm i",
    "i": "npm i --ignore-scripts",
    "i:clean": "rimraf package-lock.json node_modules && npm run i",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pack:projects": "npm run pack --prefix schematics",
    "publish:projects": "npm run publish --prefix schematics",
    "start": "nodemon --watch src --watch packages -e ts --exec \"node --inspect-brk --import tsx/esm src/test.ts\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck:projects": "npm run typecheck-projects --prefix schematics",
    "update:version": "npm run update-version --prefix schematics"
  },
  "dependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "typescript": "^6.0.3",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.2",
    "@types/convert-source-map": "^2.0.3",
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.138.0",
    "@vitest/coverage-v8": "^5.0.2",
    "depcheck": "^1.4.7",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "5.1.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26.8.0",
    "npm": ">=12.0.0"
  }
}
