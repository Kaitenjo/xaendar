{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GIT_AUTHOR_NAME": "Kaitenjo",
    "GIT_AUTHOR_EMAIL": "61583183+Kaitenjo@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "Kaitenjo",
    "GIT_COMMITTER_EMAIL": "61583183+Kaitenjo@users.noreply.github.com"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *\"git commit\"*) cd \"$CLAUDE_PROJECT_DIR\" && npm run --silent organize-imports -- --stage --hook ;; esac",
            "timeout": 120,
            "statusMessage": "Organizing the imports of the changed files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run --silent organize-imports -- --hook",
            "timeout": 120,
            "statusMessage": "Organizing the imports of the changed files"
          }
        ]
      }
    ]
  }
}
